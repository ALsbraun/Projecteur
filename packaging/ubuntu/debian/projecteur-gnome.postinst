#!/bin/sh
set -e

if [ "$1" = configure ]; then
    modprobe uinput >/dev/null 2>&1 || :
    if udevadm control --reload-rules >/dev/null 2>&1; then
        udevadm trigger --action=change --subsystem-match=misc --sysname-match=uinput >/dev/null 2>&1 || :
        udevadm settle --timeout=10 >/dev/null 2>&1 || :
    fi
fi

#DEBHELPER#
