import Gettext from 'gettext';
import Gio from 'gi://Gio';

const domain = 'projecteur';
const appDir = Gio.File.new_for_uri(import.meta.url).get_parent();
const buildLocales = appDir.get_parent().get_child('@PROJECTEUR_BUILD_LOCALE_DIRNAME@');
const inBuildTree = appDir.get_basename() === 'gnome-preferences';
Gettext.bindtextdomain(domain, inBuildTree && buildLocales.query_exists(null)
    ? buildLocales.get_path() : '@CMAKE_INSTALL_FULL_LOCALEDIR@');

export const _ = Gettext.domain(domain).gettext;
